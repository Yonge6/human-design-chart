PLUTO_SUPABASE_URL=
PLUTO_SUPABASE_PUBLISHABLE_KEY=
PLUTO_API_BASE_URL=
PLUTO_APP_VERSION=1.0.0
PLUTO_GIT_COMMIT=development
PLUTO_BUILD_DATE=development
PLUTO_ENVIRONMENT=development

# Buer private account service, separate from legacy anonymous chart storage.
BUER_ACCOUNT_URL=
BUER_ACCOUNT_PUBLISHABLE_KEY=
# Only apple,google; enable each provider only after its hosted configuration is verified.
BUER_AUTH_PROVIDERS=

# API-only values. Never expose these in browser builds.
PLUTO_API_HOST=127.0.0.1
PLUTO_API_PORT=8790
PLUTO_CORS_ORIGINS=https://human-design.wonderelian.com,https://buer.wonderelian.com,http://127.0.0.1:8789,http://localhost:8789,capacitor://localhost
PLUTO_RATE_LIMIT_PER_MINUTE=30

# Server-side Buer conversation only. Never include these in PLUTO_CONFIG.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server-only Sign in with Apple deletion/revocation values. Never expose these
# in PLUTO_CONFIG or commit the downloaded .p8 key.
BUER_APPLE_TEAM_ID=
BUER_APPLE_KEY_ID=
BUER_APPLE_PRIVATE_KEY=
# Production can use systemd LoadCredential and point this at its private
# /run/credentials/... file instead of placing the .p8 value in the environment.
BUER_APPLE_PRIVATE_KEY_FILE=
BUER_APPLE_NATIVE_CLIENT_ID=com.yonge6.buerwithin
BUER_APPLE_WEB_CLIENT_ID=com.yonge6.buerwithin.web
