{
  "version": 2,
  "rewrites": [
    {
      "source": "/v1/health",
      "destination": "/api/wendao?route=health"
    },
    {
      "source": "/v1/version",
      "destination": "/api/wendao?route=version"
    },
    {
      "source": "/v1/charts",
      "destination": "/api/wendao?route=charts"
    },
    {
      "source": "/v1/profiles",
      "destination": "/api/wendao?route=profiles"
    },
    {
      "source": "/v1/feedback",
      "destination": "/api/wendao?route=feedback"
    },
    {
      "source": "/v1/conversations",
      "destination": "/api/wendao?route=conversations"
    },
    {
      "source": "/v1/events",
      "destination": "/api/wendao?route=events"
    },
    {
      "source": "/v1/admin/login",
      "destination": "/api/wendao?route=admin-login"
    },
    {
      "source": "/v1/admin/overview",
      "destination": "/api/wendao?route=admin-overview"
    },
    {
      "source": "/v1/admin/feedback-status",
      "destination": "/api/wendao?route=admin-feedback-status"
    }
  ],
  "functions": {
    "api/wendao.mjs": {
      "includeFiles": "{src/engine/**,shared/**,supabase/functions/_shared/**,vendor/natalengine/**,vendor/swisseph/**}",
      "maxDuration": 30
    }
  }
}
