[Unit]
Description=Buer Jianji DeepSeek conversation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/buer-jianji/current
EnvironmentFile=/etc/buer-jianji/api.env
ExecStart=/usr/bin/node api/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=384M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
